# =============================================
# 게임업계 HR 뉴스봇 환경 설정
# =============================================
# 이 파일을 복사하여 .env 로 저장하고 값을 채워주세요.
# cp .env.example .env

# ---------------------------------------------
# Anthropic API (AI 요약 기능)
# https://console.anthropic.com 에서 발급
# ---------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ---------------------------------------------
# Naver News API (네이버 뉴스 검색)
# https://developers.naver.com 에서 애플리케이션 등록
# ---------------------------------------------
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# ---------------------------------------------
# 이메일 발송 설정 (SMTP)
# Gmail 사용 시: 앱 비밀번호 필요
#   (Google 계정 → 보안 → 2단계 인증 → 앱 비밀번호)
# ---------------------------------------------
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=your_email@gmail.com
EMAIL_SENDER_PASSWORD=your_app_password_here

# 뉴스 수신자 (쉼표로 구분)
EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com

# ---------------------------------------------
# 로그 설정
# ---------------------------------------------
LOG_LEVEL=INFO
